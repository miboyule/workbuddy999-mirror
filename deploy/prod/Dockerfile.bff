FROM node:22-alpine
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY server.mjs ./
COPY server ./server
COPY shared ./shared
COPY oneclick ./oneclick
COPY scripts ./scripts
COPY src/legal.json ./src/legal.json
COPY docs/legal/*.md ./docs/legal/
COPY public ./public
COPY data/daily-insights-sources.json ./data/daily-insights-sources.json
RUN chmod +x /app/oneclick/bin/server
ENV NODE_ENV=production
EXPOSE 8787
CMD ["node","server.mjs"]
